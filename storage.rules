rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // OJO: firestore.get() sobre un documento inexistente ABORTA la evaluación de
    // la regla (no devuelve null), así que la petición se deniega aunque el resto
    // de la condición fuera verdadera. Por eso siempre se consulta exists() antes.
    // Aun con esta guarda, la lectura cross-service falla para algunos directores
    // en producción: los paneles de staff suben imágenes por
    // /api/admin/upload-imagen (Admin SDK), no por el SDK del navegador.
    function userDocExists() {
      return firestore.exists(
        /databases/(default)/documents/usuarios/$(request.auth.uid)
      );
    }

    function userData() {
      return firestore.get(
        /databases/(default)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function hasAnyRole(roles) {
      return userDocExists() && (
        userData().get("rol", "") in roles ||
        userData().get("roles", []).hasAny(roles)
      );
    }

    function isDirectorOrAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "ignaciiio.mate@gmail.com" ||
        hasAnyRole(["director", "director_patio", "admin"])
      );
    }

    function isOwnerOrDirector(vendorId) {
      return isSignedIn() && (
        request.auth.uid == vendorId || isDirectorOrAdmin()
      );
    }

    // Staff que puede auditar boletas (incluye moderador, no solo director/admin).
    function isStaffStorage() {
      return isSignedIn() && (
        request.auth.token.email == "ignaciiio.mate@gmail.com" ||
        hasAnyRole(["moderador", "director", "director_patio", "admin"])
      );
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 15 * 1024 * 1024; // máx 15 MB (fotos de cámara)
    }

    // ── Fotos de locales ─────────────────────────────────────────────────────
    // Ruta: entrepreneur_photos/{vendorId}/{filename}
    match /entrepreneur_photos/{vendorId}/{fileName} {
      // Lectura pública (para mostrar imágenes en la app sin autenticación)
      allow read: if true;

      // Escritura: el propio vendedor o un director/admin
      allow write: if isOwnerOrDirector(vendorId) && isValidImage();

      // Borrado: igual que escritura
      allow delete: if isOwnerOrDirector(vendorId);
    }

    // ── Afiches publicitarios ────────────────────────────────────────────────
    // Ruta: publicidad/{filename}
    match /publicidad/{fileName} {
      allow read: if true;
      allow write: if isDirectorOrAdmin() && isValidImage();
      allow delete: if isDirectorOrAdmin();
    }

    // ── Boletas de comercios asociados (flujo auto-servicio) ──────────────────
    // Ruta: boletas/{vendorId}/{filename}
    // El cliente autenticado SUBE su boleta (no puede leer las ajenas).
    // Solo staff (moderador/director/admin) lee, para auditar. Solo staff borra.
    match /boletas/{vendorId}/{fileName} {
      // Lectura/borrado: staff (moderador/director/admin) para auditar y limpiar.
      allow read: if isStaffStorage();
      // El tipo (image/*) y el tamaño (<15MB) se validan en el cliente (BoletaForm)
      // y la operación se respalda en el endpoint /api/handshake/boleta-scan.
      // No usamos isValidImage() aquí porque el emulador de Storage no puebla de
      // forma confiable request.resource.contentType/size desde el SDK del navegador.
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isStaffStorage();
    }

    // ── Cualquier otro path: denegado ────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
