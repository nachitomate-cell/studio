
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CLUB PATIO CURAUMA - SECURITY RULES v3
     * Reglas robustas con control de acceso por rol.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Leer rol del usuario autenticado.
    // Usa exists() para evitar que la regla falle si el documento aún no existe.
    function userDoc() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    // Se usa .get("rol", "") y no .data.rol: leer un campo ausente ABORTA la
    // evaluación y deniega la petición. Un director guardado solo con el array
    // `roles` (sin el campo legacy `rol`) hacía fallar TODAS las reglas.
    function getUserRol() {
      return isSignedIn() && exists(userDoc())
        ? get(userDoc()).data.get("rol", "")
        : "";
    }

    // El modelo de roles de la app acepta las dos formas — `rol` (string legacy)
    // y `roles` (array actual), ver src/lib/roles.ts. Las reglas deben aceptar
    // ambas o el usuario entra al panel pero no puede escribir nada.
    function getUserRoles() {
      return isSignedIn() && exists(userDoc())
        ? get(userDoc()).data.get("roles", [])
        : [];
    }

    function hasAnyRol(roles) {
      return getUserRol() in roles || getUserRoles().hasAny(roles);
    }

    function isStaff() {
      return isSignedIn() && hasAnyRol(["moderador", "director_patio", "director", "admin"]);
    }

    // El rol "director" tiene las mismas facultades que "admin" — la única
    // restricción del admin es el acceso al panel /superadmin, que se gatea
    // por email (SUPERADMIN_EMAIL) en el cliente, no por estas reglas.
    function isDirector() {
      return isSignedIn() && hasAnyRol(["director_patio", "director", "admin"]);
    }

    // ── Usuarios ──────────────────────────────────────────────────────────────
    match /usuarios/{userId} {
      // Lectura individual: solo el propio usuario o staff.
      // El handshake ya corre vía Admin SDK (server-side) y no necesita esta apertura.
      allow get: if isOwner(userId) || isStaff();
      // Lista: solo staff (moderador ve todos los usuarios)
      allow list: if isStaff();
      // Creación: solo el propio usuario, y NUNCA con rol privilegiado (CRÍTICO-03)
      // Roles permitidos en auto-registro: "cliente" y "emprendedor".
      // Admin/moderador/director JAMÁS se pueden auto-asignar client-side.
      //
      // El saldo inicial se acota por RANGO, no por una lista de valores exactos.
      // Antes decía `comprasRealizadas in [0,1] && puntos in [50,100]`, que
      // asumía que el sello de bienvenida siempre valía 1. Pero el panel de
      // moderador permite fijarlo entre 1 y 10, o desactivarlo, y el registro
      // escribe `cantidad` sellos y `cantidad*100` puntos (0 y 0 si está
      // apagado). Con el sello en 2 —o apagado— la regla rechazaba TODOS los
      // registros, y como permission-denied no es un error de Auth, al cliente
      // le aparecía "Ocurrió un error inesperado" sin más pistas. Dos clicks en
      // el panel dejaban la app sin registros nuevos.
      //
      // Lo que esta regla tiene que impedir sigue igual: que alguien se
      // auto-otorgue un saldo grande al crearse. El tope (10 sellos, el mismo
      // máximo del panel) conserva esa garantía sin acoplarse a un valor
      // concreto de configuración.
      allow create: if isOwner(userId)
        && !(request.resource.data.rol in ["admin", "moderador", "director", "director_patio"])
        && request.resource.data.comprasRealizadas is int
        && request.resource.data.comprasRealizadas >= 0
        && request.resource.data.comprasRealizadas <= 10
        && request.resource.data.puntos is int
        && request.resource.data.puntos >= 0
        && request.resource.data.puntos <= 1000;
      // Actualización: staff puede modificar cualquier campo.
      // El propietario puede actualizar su propio documento pero NO puede modificar
      // campos de privilegio ni el saldo de sellos (CRÍTICO-06 / CRÍTICA-1).
      // El canje de premios y los tickets de sorteo se procesan EXCLUSIVAMENTE
      // server-side vía Admin SDK (/api/canje/create), que descuenta sellos de
      // forma atómica. El cliente jamás escribe comprasRealizadas/ticketsSorteo.
      allow update: if isStaff()
        || (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'rol', 'roles', 'baneado', 'puntos',
            'comprasRealizadas', 'sellosHistoricos', 'ticketsSorteo'
          ]));
      // Borrado: solo staff
      allow delete: if isStaff();

      // Notificaciones privadas
      match /notificaciones/{notifId} {
        allow read: if isOwner(userId) || isStaff();
        allow create: if isSignedIn();
        allow update, delete: if isOwner(userId) || isStaff();
      }

      // Registro de ventas del emprendedor
      match /ventas_registradas/{ventaId} {
        allow read: if isOwner(userId) || isStaff();
        allow create: if isSignedIn();
        allow update, delete: if isStaff();
      }
    }

    // ── Perfiles Emprendedores (directorio público) ───────────────────────────
    match /entrepreneur_profiles/{profileId} {
      allow read: if true;
      allow create: if isOwner(profileId) || isStaff();
      allow update: if isOwner(profileId) || isStaff();
      allow delete: if isStaff();
    }

    // ── Config Premios (legacy) ────────────────────────────────────────────────
    match /config_premios/{premioId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isDirector();
    }

    // ── Premios (catálogo oficial) ─────────────────────────────────────────────
    match /premios/{premioId} {
      allow read: if true; // catálogo público — incentiva registro
      allow create, delete: if isDirector();
      // CRÍTICA-1: el stock solo lo modifican directores o el Admin SDK durante
      // el canje (/api/canje/create). El cliente ya no decrementa stock directamente.
      allow update: if isDirector();
    }

    // ── Categorías de Negocios (taxonomía del directorio) ─────────────────────
    // Catálogo administrado desde /director. Lectura pública para que el cliente
    // pueda usarlas como filtros del directorio; escritura solo director/admin.
    match /categorias_negocios/{categoriaId} {
      allow read: if true;
      allow create, update, delete: if isDirector();
    }

    // ── Canjes de Premios ──────────────────────────────────────────────────────
    match /canjes/{canjeId} {
      // CRÍTICA-1: la creación de vouchers es EXCLUSIVAMENTE server-side
      // (/api/canje/create, Admin SDK). El cliente ya no puede fabricar canjes
      // sin gastar sellos. El Admin SDK ignora estas reglas.
      allow create: if false;
      // Cliente lee sus propios canjes; emprendedor lee los de su local; staff lee todo
      allow read: if isSignedIn() && (
        resource.data.clienteId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        isStaff()
      );
      // Emprendedor o staff pueden actualizar (marcar como usado)
      allow update: if isSignedIn() && (
        resource.data.vendorId == request.auth.uid || isStaff()
      );
      allow delete: if isDirector();
    }

    // ── Canjes Activos (vouchers generados) ────────────────────────────────────
    match /canjes_activos/{canjeId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      // SUGERENCIA-02: validar que el userId del canje pertenece al caller
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      // Solo staff puede marcar voucher como "usado"
      allow update: if isStaff();
      allow delete: if isDirector();
    }

    // ── Pending Stamps (Handshake Digital) ────────────────────────────────────
    // CRÍTICO-01: sin estas reglas la colección es deny-all en producción,
    // lo que rompe el flujo de canje de sellos completamente.
    match /pending_stamps/{stampId} {
      // El cliente que creó la solicitud o el vendedor pueden leerla
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        isStaff()
      );
      // Cualquier usuario autenticado puede crear una solicitud de sello
      allow create: if isSignedIn();
      // El vendedor (o staff) actualiza el estado: confirmar/rechazar/expirar.
      // El cliente puede reiniciar SU PROPIA solicitud: como el id del documento
      // ahora es determinista (uid_local), volver a entrar a /canje reescribe el
      // mismo doc en vez de crear uno nuevo. Sin esta rama el segundo escaneo
      // fallaría con permission-denied. No es un permiso nuevo en la práctica:
      // el cliente ya podía borrar el suyo y crear otro — de hecho eso es lo que
      // produjo las 84 solicitudes del 26-07-2026.
      allow update: if isSignedIn() && (
        resource.data.vendorId == request.auth.uid ||
        isStaff() ||
        (resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == "pending")
      );
      // El cliente puede cancelar su propia solicitud; el staff también
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
    }

    // ── Comunicados Globales (broadcast) ──────────────────────────────────────
    match /broadcast_messages/{messageId} {
      allow read: if isStaff();
      allow create: if isDirector();
      allow update, delete: if isDirector();
    }

    // ── Logs del Sistema (inmutables) ──────────────────────────────────────────
    match /system_logs/{logId} {
      // Staff ve todos; cada usuario puede leer sus propios logs (para calcular streak)
      allow read: if isStaff() || (isSignedIn() && resource.data.usuarioId == request.auth.uid);
      allow create: if isSignedIn();
      // Logs son inmutables: nadie puede modificar ni borrar
      allow update, delete: if false;
    }

    // ── Ofertas del Día (por local) ────────────────────────────────────────────
    match /ofertas_dia/{ofertaId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.vendorId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.vendorId == request.auth.uid || isStaff());
      allow update: if isStaff();
    }

    // ── Sugerencias de Usuarios ───────────────────────────────────────────────
    match /sugerencias/{sugerenciaId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isStaff();
      allow delete: if isDirector();
    }

    // ── Leads de Marketing ─────────────────────────────────────────────────────
    match /leads_marketing/{leadId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isDirector();
    }

    // ── Códigos de Referido ────────────────────────────────────────────────────
    // Mapa inmutable de código → userId para búsquedas O(1).
    // Cualquier autenticado puede leer (para validar un código en el formulario).
    // Solo el dueño puede crear su propio código; nunca se actualiza ni borra.
    match /codigos_referido/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Reviews de Locales ────────────────────────────────────────────────────
    // Lectura pública: cualquiera puede ver valoraciones.
    // Cada usuario autenticado puede crear/editar/eliminar solo su propia review.
    // Un usuario solo puede tener una review por vendor (validado client-side; la regla
    // solo impide que se escriba con un userId diferente al caller).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isStaff());
    }

    // ── Solicitudes de membresía al club ──────────────────────────────────────
    match /solicitudes_club/{solicitudId} {
      allow create: if true; // formulario público sin login
      allow read, update, delete: if isStaff();
    }

    // ── Tracking UTM (visitas por campaña publicitaria) ───────────────────────
    match /utm_visitas/{visitaId} {
      allow create: if true; // visitante anónimo o autenticado puede registrar su visita
      allow read, list: if isStaff();
      allow update, delete: if false;
    }

    // ── Estado de la ruleta ───────────────────────────────────────────────────
    // La pantalla del stand lo escucha en vivo para saber cuándo girar. Solo lo
    // escribe el Admin SDK (/api/admin/campana/girar): si el cliente pudiera,
    // cualquiera con la consola abierta se declararía ganador en pantalla.
    match /ruleta/{campana} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ── Sorteos de campaña (eventos, ferias) ──────────────────────────────────
    // Solo los escribe el Admin SDK (/api/admin/campana/sortear), que ignora
    // estas reglas. El cliente jamás escribe: si pudiera, podría fabricarse un
    // premio. El staff lee para mostrar el historial en el panel.
    match /sorteos/{sorteoId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ── Configuración Global (publicidad, etc.) ────────────────────────────────
    // Lectura pública: el afiche se muestra a cualquier visitante, autenticado o no.
    // Escritura restringida a directores/admins.
    match /config/{docId} {
      allow read: if true;
      allow write: if isDirector();

      // Historial de campañas publicitarias: solo directores, inmutable (no delete)
      match /historial/{entryId} {
        allow read: if isDirector();
        allow create, update: if isDirector();
        allow delete: if false;
      }
    }

    // ── Configuración del Club (colección actual usada por la app) ─────────────
    // Contiene el doc `general` con selloBienvenida y recompensaEmprendedor.
    // Lectura pública: el flujo de registro en /unete y los endpoints server-side
    // necesitan leerla sin sesión iniciada. Escritura solo para staff (moderador,
    // director, admin) que opera /moderador con PIN.
    match /configuracion/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ── Mundial (retirado tras el torneo 2026) ────────────────────────────────
    // Las colecciones `mundial_partidos` y `mundial_pronosticos` se conservan
    // como archivo histórico, pero ya no tienen reglas: sin un match explícito
    // Firestore deniega todo acceso del cliente. Solo el Admin SDK (que ignora
    // las reglas) puede leerlas si alguna vez hay que consultarlas o revivirlas.
  }
}
