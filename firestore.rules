
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CLUB PATIO CURAUMA - SECURITY RULES v2
     * 
     * Reglas optimizadas para evitar errores de snapshot listeners.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Colección: Usuarios (Perfiles y Puntos) ---
    match /usuarios/{userId} {
      // Simplificado para evitar recursividad pesada en reglas
      allow get: if isOwner(userId) || isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isSignedIn();
      allow delete: if isSignedIn();

      // Subcolección: Notificaciones Privadas
      match /notificaciones/{notifId} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn();
        allow update, delete: if isOwner(userId);
      }

      // Subcolección: Ventas Registradas (para Emprendedores)
      match /ventas_registradas/{ventaId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
      }
    }

    // --- Colección: Perfiles de Emprendedores ---
    // Sincronizado con EntrepreneurDetailView y VendedorPage
    match /entrepreneur_profiles/{profileId} {
      allow read: if true; // El directorio es público
      allow write: if isSignedIn();
    }

    // --- Colección: Configuración de Premios ---
    match /config_premios/{premioId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Colección: Logs del Sistema ---
    match /system_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
    }

    // --- Colección: Puntos de Mapa ---
    match /map_points/{pointId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
