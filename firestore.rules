rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CLUB PATIO CURAUMA - SECURITY RULES
     * 
     * Este conjunto de reglas permite la operación fluida del sistema de fidelización
     * protegiendo la privacidad de los usuarios y restringiendo funciones críticas a directores.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Colección: Usuarios (Perfiles y Puntos) ---
    match /usuarios/{userId} {
      allow get: if isOwner(userId) || (isSignedIn() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin', 'director']);
      allow list: if isSignedIn() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin', 'director'];
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || (isSignedIn() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin', 'director']);
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';

      // Subcolección: Notificaciones Privadas
      match /notificaciones/{notifId} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn(); // Permite que otros (vendedores/sistema) envíen notificaciones
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Subcolección: Ventas Registradas (para Emprendedores)
      match /ventas_registradas/{ventaId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
      }
    }

    // --- Colección: Perfiles de Emprendedores ---
    match /entrepreneur_profiles/{profileId} {
      allow read: if true; // El directorio es público
      allow create, update: if isSignedIn() && (request.auth.uid == profileId || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin');
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // --- Colección: Configuración de Premios (Director/Admin) ---
    match /config_premios/{premioId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin', 'director'];
    }

    // --- Colección: Logs del Sistema (Auditoría) ---
    match /system_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin', 'director'];
    }

    // --- Colección: Puntos de Mapa ---
    match /map_points/{pointId} {
      allow read: if true;
      allow write: if isSignedIn() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }
  }
}