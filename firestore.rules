
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CLUB PATIO CURAUMA - SECURITY RULES v3
     * Reglas robustas con control de acceso por rol.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Leer rol del usuario autenticado sin recursividad en lista
    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isSignedIn() && getUserData().rol in ["moderador", "director_patio", "director", "admin"];
    }

    function isAdmin() {
      return isSignedIn() && getUserData().rol == "admin";
    }

    function isDirector() {
      return isSignedIn() && getUserData().rol in ["director_patio", "director", "admin"];
    }

    // ── Usuarios ──────────────────────────────────────────────────────────────
    match /usuarios/{userId} {
      // Lectura: propio perfil o staff
      allow get: if isOwner(userId) || isStaff();
      // Lista: solo staff (moderador ve todos los usuarios)
      allow list: if isStaff();
      // Creación: solo el propio usuario en el momento de registro
      allow create: if isOwner(userId);
      // Actualización: el dueño o staff
      allow update: if isOwner(userId) || isStaff();
      // Borrado: solo staff
      allow delete: if isStaff();

      // Notificaciones privadas
      match /notificaciones/{notifId} {
        allow read: if isOwner(userId) || isStaff();
        allow create: if isSignedIn();
        allow update, delete: if isOwner(userId) || isStaff();
      }

      // Registro de ventas del emprendedor
      match /ventas_registradas/{ventaId} {
        allow read: if isOwner(userId) || isStaff();
        allow create: if isSignedIn();
        allow update, delete: if isStaff();
      }
    }

    // ── Perfiles Emprendedores (directorio público) ───────────────────────────
    match /entrepreneur_profiles/{profileId} {
      allow read: if true;
      allow create: if isOwner(profileId) || isStaff();
      allow update: if isOwner(profileId) || isStaff();
      allow delete: if isStaff();
    }

    // ── Config Premios ─────────────────────────────────────────────────────────
    match /config_premios/{premioId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isDirector();
    }

    // ── Canjes Activos (vouchers generados) ────────────────────────────────────
    match /canjes_activos/{canjeId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow create: if isSignedIn();
      // Solo staff puede marcar voucher como "usado"
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── Logs del Sistema (inmutables) ──────────────────────────────────────────
    match /system_logs/{logId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      // Logs son inmutables: nadie puede modificar ni borrar
      allow update, delete: if false;
    }

    // ── Leads de Marketing ─────────────────────────────────────────────────────
    match /leads_marketing/{leadId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
