
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CLUB PATIO CURAUMA - SECURITY RULES v3
     * Reglas robustas con control de acceso por rol.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Leer rol del usuario autenticado.
    // Usa exists() para evitar que la regla falle si el documento aún no existe.
    function userDoc() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function getUserRol() {
      return isSignedIn() && exists(userDoc())
        ? get(userDoc()).data.rol
        : "";
    }

    function isStaff() {
      return isSignedIn() && getUserRol() in ["moderador", "director_patio", "director", "admin"];
    }

    function isAdmin() {
      return isSignedIn() && getUserRol() == "admin";
    }

    function isDirector() {
      return isSignedIn() && getUserRol() in ["director_patio", "director", "admin"];
    }

    // Función helper: verifica si el usuario tiene rol de emprendedor.
    // Soporta tanto rol string (legacy) como array roles (nuevo sistema multi-rol).
    function isEmprendedor() {
      return isSignedIn() && exists(userDoc()) && (
        get(userDoc()).data.rol == "emprendedor" ||
        get(userDoc()).data.get("roles", []).hasAny(["emprendedor"])
      );
    }

    // ── Usuarios ──────────────────────────────────────────────────────────────
    match /usuarios/{userId} {
      // Lectura individual: cualquier usuario autenticado puede leer un perfil específico.
      // Necesario para que el handshake (confirmarHandshake) pueda hacer get()
      // sobre el documento del cliente dentro de la transacción.
      // La operación list (enumerar todos) sigue siendo solo staff.
      allow get: if isSignedIn();
      // Lista: solo staff (moderador ve todos los usuarios)
      allow list: if isStaff();
      // Creación: solo el propio usuario, y NUNCA con rol privilegiado (CRÍTICO-03)
      // Roles permitidos en auto-registro: "cliente" y "emprendedor".
      // Admin/moderador/director JAMÁS se pueden auto-asignar client-side.
      allow create: if isOwner(userId)
        && !(request.resource.data.rol in ["admin", "moderador", "director", "director_patio"])
        && request.resource.data.comprasRealizadas == 1
        && request.resource.data.puntos == 100;
      // Actualización: el dueño, staff, o un emprendedor actualizando solo campos de sellos.
      // Los emprendedores necesitan incrementar comprasRealizadas/puntos durante el handshake,
      // pero nunca pueden modificar campos sensibles o asignar valores arbitrarios.
      allow update: if isOwner(userId) || isStaff() || (
        isEmprendedor() && 
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['comprasRealizadas', 'puntos', 'lastVendorScans', 'sellosLocales', 'lastPurchaseAt', 'lastUpdate']) &&
        request.resource.data.comprasRealizadas == resource.data.comprasRealizadas + 1
      );
      // Borrado: solo staff
      allow delete: if isStaff();

      // Notificaciones privadas
      match /notificaciones/{notifId} {
        allow read: if isOwner(userId) || isStaff();
        allow create: if isSignedIn();
        allow update, delete: if isOwner(userId) || isStaff();
      }

      // Registro de ventas del emprendedor
      match /ventas_registradas/{ventaId} {
        allow read: if isOwner(userId) || isStaff();
        allow create: if isSignedIn();
        allow update, delete: if isStaff();
      }
    }

    // ── Perfiles Emprendedores (directorio público) ───────────────────────────
    match /entrepreneur_profiles/{profileId} {
      allow read: if true;
      allow create: if isOwner(profileId) || isStaff();
      allow update: if isOwner(profileId) || isStaff();
      allow delete: if isStaff();
    }

    // ── Config Premios (legacy) ────────────────────────────────────────────────
    match /config_premios/{premioId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isDirector();
    }

    // ── Premios (catálogo oficial) ─────────────────────────────────────────────
    match /premios/{premioId} {
      allow read: if isSignedIn();
      allow create, delete: if isDirector();
      // Directores pueden modificar cualquier campo.
      // Clientes autenticados solo pueden decrementar stock en 1 (durante canje).
      // La regla valida: solo el campo 'stock' cambia, baja exactamente en 1 y era > 0.
      allow update: if isDirector() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
        request.resource.data.stock == resource.data.stock - 1 &&
        resource.data.stock > 0
      );
    }

    // ── Canjes de Premios ──────────────────────────────────────────────────────
    match /canjes/{canjeId} {
      // Cliente crea su propio canje (clienteId debe coincidir con su uid)
      allow create: if isSignedIn()
        && request.resource.data.clienteId == request.auth.uid;
      // Cliente lee sus propios canjes; emprendedor lee los de su local; staff lee todo
      allow read: if isSignedIn() && (
        resource.data.clienteId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        isStaff()
      );
      // Emprendedor o staff pueden actualizar (marcar como usado)
      allow update: if isSignedIn() && (
        resource.data.vendorId == request.auth.uid || isStaff()
      );
      allow delete: if isAdmin();
    }

    // ── Canjes Activos (vouchers generados) ────────────────────────────────────
    match /canjes_activos/{canjeId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      // SUGERENCIA-02: validar que el userId del canje pertenece al caller
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      // Solo staff puede marcar voucher como "usado"
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── Pending Stamps (Handshake Digital) ────────────────────────────────────
    // CRÍTICO-01: sin estas reglas la colección es deny-all en producción,
    // lo que rompe el flujo de canje de sellos completamente.
    match /pending_stamps/{stampId} {
      // El cliente que creó la solicitud o el vendedor pueden leerla
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        isStaff()
      );
      // Cualquier usuario autenticado puede crear una solicitud de sello
      allow create: if isSignedIn();
      // Solo el vendedor (o staff) puede actualizar el estado (confirmar/rechazar)
      allow update: if isSignedIn() && (
        resource.data.vendorId == request.auth.uid || isStaff()
      );
      // El cliente puede cancelar su propia solicitud; el staff también
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
    }

    // ── Logs del Sistema (inmutables) ──────────────────────────────────────────
    match /system_logs/{logId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      // Logs son inmutables: nadie puede modificar ni borrar
      allow update, delete: if false;
    }

    // ── Leads de Marketing ─────────────────────────────────────────────────────
    match /leads_marketing/{leadId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
